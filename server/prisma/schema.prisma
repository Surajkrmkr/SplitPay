generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  avatar    String?
  googleId  String?  @unique @map("google_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sessions            Session[]
  groups              GroupMember[]
  paidExpenses        Expense[]            @relation("paidBy")
  expenseParticipants ExpenseParticipant[]
  sentSettlements     Settlement[]         @relation("payer")
  receivedSettlements Settlement[]         @relation("payee")
  activities          Activity[]
  createdInvites      GroupInvite[]
  fcmTokens           FcmToken[]
  notifications       Notification[]
  transactions        Transaction[]
  userCategories      UserCategory[]

  @@map("users")
}

model Session {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  refreshToken String   @unique @map("refresh_token")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Group {
  id          String   @id @default(uuid())
  name        String
  description String?
  avatar      String?
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  members       GroupMember[]
  expenses      Expense[]
  settlements   Settlement[]
  activities    Activity[]
  invites       GroupInvite[]
  notifications Notification[]

  @@map("groups")
}

model GroupMember {
  id       String    @id @default(uuid())
  groupId  String    @map("group_id")
  userId   String    @map("user_id")
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now()) @map("joined_at")

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
  @@map("group_members")
}

enum GroupRole {
  ADMIN
  MEMBER
}

model Expense {
  id        String    @id @default(uuid())
  groupId   String    @map("group_id")
  title     String
  amount    Decimal   @db.Decimal(12, 2)
  paidById  String    @map("paid_by_id")
  splitType SplitType @map("split_type")
  notes     String?
  date      DateTime  @default(now())
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  group        Group                @relation(fields: [groupId], references: [id], onDelete: Cascade)
  paidBy       User                 @relation("paidBy", fields: [paidById], references: [id])
  participants ExpenseParticipant[]
  activities   Activity[]

  @@index([groupId])
  @@index([paidById])
  @@map("expenses")
}

enum SplitType {
  EQUAL
  PERCENTAGE
  EXACT
}

model ExpenseParticipant {
  id         String   @id @default(uuid())
  expenseId  String   @map("expense_id")
  userId     String   @map("user_id")
  share      Decimal  @db.Decimal(12, 2)
  percentage Decimal? @db.Decimal(5, 2)

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([expenseId, userId])
  @@index([expenseId])
  @@index([userId])
  @@map("expense_participants")
}

model Settlement {
  id        String   @id @default(uuid())
  groupId   String   @map("group_id")
  payerId   String   @map("payer_id")
  payeeId   String   @map("payee_id")
  amount    Decimal  @db.Decimal(12, 2)
  notes     String?
  settledAt DateTime @default(now()) @map("settled_at")
  createdAt DateTime @default(now()) @map("created_at")

  group      Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  payer      User       @relation("payer", fields: [payerId], references: [id])
  payee      User       @relation("payee", fields: [payeeId], references: [id])
  activities Activity[]

  @@index([groupId])
  @@index([payerId])
  @@index([payeeId])
  @@map("settlements")
}

model Activity {
  id           String       @id @default(uuid())
  groupId      String       @map("group_id")
  userId       String       @map("user_id")
  type         ActivityType
  expenseId    String?      @map("expense_id")
  settlementId String?      @map("settlement_id")
  metadata     Json?
  createdAt    DateTime     @default(now()) @map("created_at")

  group      Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id])
  expense    Expense?    @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  settlement Settlement? @relation(fields: [settlementId], references: [id], onDelete: SetNull)

  @@index([groupId])
  @@index([userId])
  @@map("activities")
}

model GroupInvite {
  id          String   @id @default(uuid())
  code        String   @unique
  groupId     String   @map("group_id")
  createdById String   @map("created_by_id")
  expiresAt   DateTime @map("expires_at")
  maxUses     Int      @default(10) @map("max_uses")
  usedCount   Int      @default(0) @map("used_count")
  createdAt   DateTime @default(now()) @map("created_at")

  group     Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy User  @relation(fields: [createdById], references: [id])

  @@index([groupId])
  @@map("group_invites")
}

model FcmToken {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  token      String   @unique
  deviceType String   @map("device_type")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("fcm_tokens")
}

model Notification {
  id          String           @id @default(uuid())
  userId      String           @map("user_id")
  type        NotificationType
  title       String
  body        String
  groupId     String?          @map("group_id")
  actorName   String?          @map("actor_name")
  actorAvatar String?          @map("actor_avatar")
  isRead      Boolean          @default(false) @map("is_read")
  data        Json?
  createdAt   DateTime         @default(now()) @map("created_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, isRead])
  @@map("notifications")
}

enum ActivityType {
  EXPENSE_ADDED
  EXPENSE_DELETED
  SETTLEMENT_COMPLETED
  MEMBER_JOINED
  MEMBER_REMOVED
  GROUP_CREATED
}

enum NotificationType {
  GROUP_EXPENSE_ADDED
  SETTLEMENT_RECEIVED
  ADDED_TO_GROUP
  PAYMENT_REMINDER
  GROUP_ACTIVITY
}

// ─── Personal Transaction Module ──────────────────────────────────────────────

model Transaction {
  id               String              @id @default(uuid())
  userId           String              @map("user_id")
  amount           Decimal             @db.Decimal(12, 2)
  type             PersonalTxType      @map("transaction_type")
  categoryKey      String              @map("category_key")
  customCategoryId String?             @map("custom_category_id")
  appIcon          String?             @map("app_icon")
  note             String?
  date             DateTime
  recurrence       TxRecurrenceType    @default(NONE)
  groupId          String?             @map("group_id")
  deviceId         String?             @map("device_id")
  deletedAt        DateTime?           @map("deleted_at")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, deletedAt])
  @@index([userId, date])
  @@index([userId, type])
  @@map("transactions")
}

model UserCategory {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  label         String
  colorValue    Int       @map("color_value")
  iconCodePoint Int       @map("icon_code_point")
  deletedAt     DateTime? @map("deleted_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_categories")
}

enum PersonalTxType {
  INCOME
  EXPENSE
  TRANSFER
}

enum TxRecurrenceType {
  NONE
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}
