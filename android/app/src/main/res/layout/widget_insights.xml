<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/w2_card_bg"
    android:padding="14dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SPENT THIS MONTH"
        android:textColor="@color/w2_text_secondary"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/in_week_total"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="₹0.00"
        android:textColor="@color/w2_text_primary"
        android:textSize="17sp"
        android:textStyle="bold" />

    <!-- Chart area -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp">

        <TextView
            android:id="@+id/in_axis_top"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentStart="true"
            android:text="10"
            android:textColor="@color/w2_text_secondary"
            android:textSize="8sp" />

        <TextView
            android:id="@+id/in_axis_bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_alignParentStart="true"
            android:text="0"
            android:textColor="@color/w2_text_secondary"
            android:textSize="8sp" />

        <ImageView
            android:id="@+id/in_bar_chart_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="16dp"
            android:scaleType="fitXY" />

        <LinearLayout
            android:id="@+id/in_empty_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_marginStart="16dp"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NO TRANSACTIONS\nTHIS MONTH"
                android:gravity="center"
                android:textColor="@color/w2_text_secondary"
                android:textSize="9sp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/in_add_expense_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/w2_pill_bg"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:text="+ New Expense"
                android:textColor="@color/w2_pill_text"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Bucket labels: W1 W2 W3 W4 W5 (one per ~week of the current month) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginStart="16dp"
        android:layout_marginTop="2dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="W1"
            android:textColor="@color/w2_text_secondary"
            android:textSize="8sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="W2"
            android:textColor="@color/w2_text_secondary"
            android:textSize="8sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="W3"
            android:textColor="@color/w2_text_secondary"
            android:textSize="8sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="W4"
            android:textColor="@color/w2_text_secondary"
            android:textSize="8sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="W5"
            android:textColor="@color/w2_text_secondary"
            android:textSize="8sp" />
    </LinearLayout>
</LinearLayout>
