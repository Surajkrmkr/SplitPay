<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/w2_card_bg"
    android:padding="14dp">

    <!-- Header row: period label + decorative ring icon -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top">

        <TextView
            android:id="@+id/ob_period_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="1 - 31 AUG"
            android:textColor="@color/w2_text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1" />

        <ImageView
            android:id="@+id/ob_ring_icon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginStart="6dp"
            android:src="@drawable/w2_ring_icon" />
    </LinearLayout>

    <TextView
        android:id="@+id/ob_spent_caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="SPENT: 0%"
        android:textColor="@color/w2_text_secondary"
        android:textSize="10sp"
        android:textStyle="bold" />

    <!-- Gauge area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/ob_gauge_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:id="@+id/ob_gauge_center_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/ob_remaining_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹0"
                android:textColor="@color/w2_text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="left this month"
                android:textColor="@color/w2_text_secondary"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ob_empty_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No budgets yet"
                android:textColor="@color/w2_text_secondary"
                android:textSize="11sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/ob_add_budget_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/w2_pill_bg"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="+ Add Budget"
                android:textColor="@color/w2_pill_text"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <!-- Bottom anchors: spent / limit -->
    <LinearLayout
        android:id="@+id/ob_bottom_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/ob_spent_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="start"
            android:text="0"
            android:textColor="@color/w2_text_secondary"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/ob_limit_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="0"
            android:textColor="@color/w2_text_secondary"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
