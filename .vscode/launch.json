    "version": "0.2.0",
    "configurations": [
        {
            "name": "dimeflow",
            "request": "launch",
            "type": "dart",
            // "args": [
            //     "--dart-define=API_BASE_URL=http://64.227.135.37:3000/api/v1"
            // ]
        },
        {
            "name": "dimeflow (build APK)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "args": [
                "build",
                "apk",
                "--split-per-abi",
                "--dart-define=API_BASE_URL=http://64.227.135.37:3000/api/v1"
            ]
        },
        {
            "name": "dimeflow (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "dimeflow (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        }
    ]
