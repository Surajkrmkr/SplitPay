default_platform(:ios)

require "shellwords"

platform :ios do
  private_lane :build_app_with_api_key do
    raw_path = ENV["APP_STORE_CONNECT_API_KEY_PATH"] || "AuthKey.p8"
    resolved_path = raw_path
    unless File.exist?(resolved_path)
      candidates = [
        File.join(Dir.pwd, raw_path),
        File.join(Dir.pwd, "..", raw_path),
        File.join(Dir.pwd, "..", "..", raw_path)
      ]
      found = candidates.find { |p| File.exist?(p) }
      resolved_path = found if found
    end
    key_path = File.expand_path(resolved_path)
    UI.user_error!("App Store Connect API key not found: #{key_path}") unless File.exist?(key_path)

    key_id = ENV["APP_STORE_CONNECT_API_KEY_ID"]
    issuer_id = ENV["APP_STORE_CONNECT_ISSUER_ID"]
    UI.user_error!("APP_STORE_CONNECT_API_KEY_ID is not set") if key_id.to_s.empty?
    UI.user_error!("APP_STORE_CONNECT_ISSUER_ID is not set") if issuer_id.to_s.empty?

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_path,
      in_house: false
    )

    team_id = ENV["APPLE_TEAM_ID"]
    xcode_api_key_args = [
      "-allowProvisioningUpdates",
      "-authenticationKeyPath #{Shellwords.escape(key_path)}",
      "-authenticationKeyID #{Shellwords.escape(key_id)}",
      "-authenticationKeyIssuerID #{Shellwords.escape(issuer_id)}"
    ].join(" ")

    xcargs_flags = xcode_api_key_args.dup
    xcargs_flags += " DEVELOPMENT_TEAM=#{Shellwords.escape(team_id)}" if team_id && !team_id.empty?

    # Always export with the installed App Store profiles for the app and widget.
    app_profile_name = ENV["IOS_APP_STORE_PROFILE_NAME"]
    widget_profile_name = ENV["IOS_WIDGET_APP_STORE_PROFILE_NAME"]
    UI.user_error!("IOS_APP_STORE_PROFILE_NAME is not set") if app_profile_name.to_s.empty?
    UI.user_error!("IOS_WIDGET_APP_STORE_PROFILE_NAME is not set") if widget_profile_name.to_s.empty?

    export_opts = {
      method: "app-store",
      signingStyle: "manual",
      provisioningProfiles: {
        "com.splitpay.expensetracker" => app_profile_name,
        "com.splitpay.expensetracker.DimeWidgets" => widget_profile_name
      }
    }
    export_opts[:teamID] = team_id if team_id && !team_id.empty?

    # Let Xcode manage signing during archive and export using the API key.
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      export_team_id: team_id,
      export_options: export_opts,
      xcargs: xcargs_flags
    )

    api_key
  end

  desc "Build and upload to App Store (Production)"
  lane :release do
    api_key = build_app_with_api_key
    upload_to_app_store(
      api_key: api_key,
      skip_metadata: true,
      skip_screenshots: true,
      force: true
    )
  end

  desc "Alias for release lane"
  lane :production do
    release
  end

  desc "Build and upload to TestFlight (Beta testing)"
  lane :beta do
    api_key = build_app_with_api_key
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end
end
