default_platform(:ios)

platform :ios do
  private_lane :build_app_with_api_key do
    raw_path = ENV["APP_STORE_CONNECT_API_KEY_PATH"] || "AuthKey.p8"
    resolved_path = raw_path
    unless File.exist?(resolved_path)
      candidates = [
        File.join(Dir.pwd, raw_path),
        File.join(Dir.pwd, "..", raw_path),
        File.join(Dir.pwd, "..", "..", raw_path)
      ]
      found = candidates.find { |p| File.exist?(p) }
      resolved_path = found if found
    end
    key_path = File.expand_path(resolved_path)

    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_filepath: key_path,
      in_house: false
    )

    team_id = ENV["APPLE_TEAM_ID"]
    xcargs_flags = "-allowProvisioningUpdates CODE_SIGNING_ALLOWED=NO"
    xcargs_flags += " DEVELOPMENT_TEAM='#{team_id}'" if team_id && !team_id.empty?

    # Archive without requiring local development profiles (CODE_SIGNING_ALLOWED=NO).
    # Then gym runs xcodebuild -exportArchive with export_method: "app-store"
    # and -allowProvisioningUpdates using the App Store Connect API key to
    # sign the IPA with the Distribution certificate in the CI keychain.
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      export_team_id: team_id,
      skip_profile_detection: true,
      xcargs: xcargs_flags
    )

    api_key
  end

  desc "Build and upload to App Store (Production)"
  lane :release do
    api_key = build_app_with_api_key
    upload_to_app_store(
      api_key: api_key,
      skip_metadata: true,
      skip_screenshots: true,
      skip_waiting_for_build_processing: true,
      force: true
    )
  end

  desc "Alias for release lane"
  lane :production do
    release
  end

  desc "Build and upload to TestFlight (Beta testing)"
  lane :beta do
    api_key = build_app_with_api_key
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end
end
