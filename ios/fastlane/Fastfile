default_platform(:ios)

platform :ios do
  private_lane :build_app_with_api_key do
    raw_path = ENV["APP_STORE_CONNECT_API_KEY_PATH"] || "AuthKey.p8"
    resolved_path = raw_path
    unless File.exist?(resolved_path)
      candidates = [
        File.join(Dir.pwd, raw_path),
        File.join(Dir.pwd, "..", raw_path),
        File.join(Dir.pwd, "..", "..", raw_path)
      ]
      found = candidates.find { |p| File.exist?(p) }
      resolved_path = found if found
    end
    key_path = File.expand_path(resolved_path)

    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_filepath: key_path,
      in_house: false
    )

    key_id = ENV["APP_STORE_CONNECT_API_KEY_ID"]
    issuer_id = ENV["APP_STORE_CONNECT_ISSUER_ID"]

    auth_args = "-allowProvisioningUpdates"
    if File.exist?(key_path) && key_id && issuer_id
      auth_args += " -authenticationKeyPath '#{key_path}' -authenticationKeyID '#{key_id}' -authenticationKeyIssuerID '#{issuer_id}'"
    end

    # Signing stays "Automatic" in the Xcode project (see project.pbxproj) —
    # -allowProvisioningUpdates lets Xcode fetch/refresh the App Store
    # provisioning profile itself via the API key, as long as a matching
    # Distribution certificate is already present in the CI keychain.
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      xcargs: auth_args,
      export_xcargs: auth_args
    )

    api_key
  end

  desc "Build and upload to App Store (Production)"
  lane :release do
    api_key = build_app_with_api_key
    upload_to_app_store(
      api_key: api_key,
      skip_metadata: true,
      skip_screenshots: true,
      skip_waiting_for_build_processing: true,
      force: true
    )
  end

  desc "Alias for release lane"
  lane :production do
    release
  end

  desc "Build and upload to TestFlight (Beta testing)"
  lane :beta do
    api_key = build_app_with_api_key
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end
end
