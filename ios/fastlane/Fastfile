default_platform(:ios)

platform :ios do
  desc "Build and upload to TestFlight (internal testing)"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_filepath: ENV["APP_STORE_CONNECT_API_KEY_PATH"],
      in_house: false
    )

    # Signing stays "Automatic" in the Xcode project (see project.pbxproj) —
    # -allowProvisioningUpdates lets Xcode fetch/refresh the App Store
    # provisioning profile itself via the API key, as long as a matching
    # Distribution certificate is already present in the CI keychain.
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      api_key: api_key,
      xcargs: "-allowProvisioningUpdates"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end
end
