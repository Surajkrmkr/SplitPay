default_platform(:ios)

platform :ios do
  desc "Build and upload to TestFlight (internal testing)"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_filepath: ENV["APP_STORE_CONNECT_API_KEY_PATH"],
      in_house: false
    )

    key_path = File.expand_path(ENV["APP_STORE_CONNECT_API_KEY_PATH"]) if ENV["APP_STORE_CONNECT_API_KEY_PATH"]
    key_id = ENV["APP_STORE_CONNECT_API_KEY_ID"]
    issuer_id = ENV["APP_STORE_CONNECT_ISSUER_ID"]

    auth_args = "-allowProvisioningUpdates"
    if key_path && key_id && issuer_id
      auth_args += " -authenticationKeyPath '#{key_path}' -authenticationKeyID '#{key_id}' -authenticationKeyIssuerID '#{issuer_id}'"
    end

    # Signing stays "Automatic" in the Xcode project (see project.pbxproj) —
    # -allowProvisioningUpdates lets Xcode fetch/refresh the App Store
    # provisioning profile itself via the API key, as long as a matching
    # Distribution certificate is already present in the CI keychain.
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      xcargs: auth_args,
      export_xcargs: auth_args
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end
end
